{
  "name": "AI Learning Buddy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "Maya Learning Buddy", "onAutoForward": "openBrowser", "visibility": "private"}},
  "containerEnv": {"MEM0_TELEMETRY": "false"}
}
